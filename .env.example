# Optional: set an API key to run RefundGuard with live LLM inference.
# Supported by @mozaik-ai/core@6.0.0: OPENAI_API_KEY, ANTHROPIC_API_KEY, or GEMINI_API_KEY.
# Leave unset (or set REFUND_GUARD_MODE=mock) to use the built-in deterministic
# Mozaik MockInferenceRunner with zero external API keys required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# "auto" (uses live when an API key is set, otherwise mock), "live", or "mock"
REFUND_GUARD_MODE=auto

# Optional model override from @mozaik-ai/core@6.0.0 supportedModels
# Defaults: gpt-5.4-mini (OpenAI), claude-haiku-4-5 (Anthropic), gemini-3.5-flash (Gemini)
REFUND_GUARD_MODEL=

# Local HTTP server port for `npm start`
PORT=3000
