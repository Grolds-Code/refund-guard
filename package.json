{
  "name": "refund-guard",
  "version": "1.0.0",
  "description": "Concurrent Mozaik AI agents with awaited pre-execution interception and epoch-enforced approvals for Black Friday marketplace refund and payout reconciliation.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "cli": "node --import tsx src/cli.ts",
    "compare": "node --import tsx src/compare.ts",
    "trace:live": "node --import tsx src/live-trace.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozaik-ai/core": "6.0.0",
    "dotenv": "^17.4.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
